# GEMINI_API_KEY / GEMINI_FREE_API_KEY: Chave principal gratuita (Free Tier diário).
# A aplicação gasta sempre primeiro os tokens gratuitos desta chave (Custo 0€).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_FREE_API_KEY=""

# GEMINI_PAID_API_KEY: Chave paga (Pay-as-you-go).
# Só é utilizada como contingência se e quando a quota diária gratuita da chave principal esgotar (Erro 429).
GEMINI_PAID_API_KEY=""

# RESEND_API_KEY: Resend API key for sending real emails to Administrator and Employees.
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=

# SENDER_EMAIL: Sender email address verified in Resend (e.g. onboarding@resend.dev or no-reply@datacolab.pt)
SENDER_EMAIL="onboarding@resend.dev"

# Web Push VAPID keys for background browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:suporte@datacolab.pt"

